            const blips = document.getElementById('radar-blips');
            blips.innerHTML = '';
            const size = 112;

            enemies.forEach(e => {
                if (e.hp <= 0) return;
                const rx = (e.mesh.position.x - playerGroup.position.x) * 1.2;
                const rz = (e.mesh.position.z - playerGroup.position.z) * 1.2;

                if (Math.abs(rx) < size / 2 && Math.abs(rz) < size / 2) {
                    const dot = document.createElement('div');
                    dot.className = 'absolute w-2 h-2 bg-red-500 rounded-full shadow-[0_0_6px_#f00]';
                    dot.style.left = `${size / 2 + rx}px`;
