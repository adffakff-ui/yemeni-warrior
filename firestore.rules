rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User Profile Rules
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) 
        && incoming().uid == request.auth.uid
        && incoming().displayName is string
        && incoming().displayName.size() <= 60;
      allow update: if isOwner(userId)
        && incoming().uid == existing().uid
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'photoURL', 'email', 'totalWins', 'totalKills', 'totalMatches', 'highScore', 'lastPlayed'
        ]);
      allow delete: if false;

      // Historical Match Records for each user
      match /matches/{matchId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && incoming().userId == request.auth.uid
          && incoming().score is number
          && incoming().kills is number
          && incoming().timestamp == request.time;
        allow update, delete: if false;
      }
    }

    // Global Public Leaderboard Rules
    match /leaderboard/{entryId} {
      allow read: if true;
      allow create: if isSignedIn()
        && incoming().userId == request.auth.uid
        && incoming().score is number
        && incoming().timestamp == request.time;
      allow update, delete: if false;
    }

    // Default catch-all deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
